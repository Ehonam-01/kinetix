# Postgres connection used by Drizzle (server-only). Get this from your Supabase
# project's Database settings (use the pooled "Transaction" connection string).
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase project settings (Project Settings > API). Public: inlined into the
# client bundle at build time, safe to expose.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only, never expose to the client — bypasses RLS and can manage any
# auth.users row. Used to lock out a member's login on account deletion
# (services/account/lock-auth-account.ts): ban + password reset + email
# change, never a real delete (deleting the auth row would cascade-delete
# their profiles row, which account deletion deliberately keeps —
# anonymized — for the sake of everyone else's genealogy/ledger history).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Moneroo (Dashboard > Developers). Use a test_ key for sandbox. Server-only.
MONEROO_SECRET_KEY="test_your-secret-key"
# Dashboard > Developers > Webhooks > (your endpoint) > signing secret.
MONEROO_WEBHOOK_SECRET="your-webhook-signing-secret"

# Bictorys (Dashboard > Developers > API Keys and Webhooks Configuration).
# Private/secret key — server-only, never expose in frontend/mobile code.
# Use the Test-mode key for sandbox.
BICTORYS_SECRET_KEY="test_your-secret-key"
# Same screen, "Webhook Secret Key" — validates the X-Secret-Key header
# Bictorys sends on every webhook call.
BICTORYS_WEBHOOK_SECRET="your-webhook-signing-secret"
# Dashboard > Developers > Transfer settings — 4-digit PIN required by the
# payout endpoint (merchant.secretCode). Only needed for automated
# withdrawal payouts, not inbound charges.
BICTORYS_MERCHANT_SECRET_CODE="0000"

# PayDunya (paydunya.com > Compte > API keys). Server-only.
PAYDUNYA_MASTER_KEY="your-master-key"
PAYDUNYA_PRIVATE_KEY="test_your-private-key"
PAYDUNYA_TOKEN="your-token"

# Resend (resend.com/api-keys) — sends the transfer confirmation OTP email
# (services/wallet/initiate-transfer.ts). Server-only. Resend requires a
# verified sending domain (Dashboard > Domains) for EMAIL_FROM in
# production; onboarding@resend.dev is the address Resend's own docs use
# as a test sender before you've verified one. Testing without a verified
# domain also means real recipients besides yourself may not receive mail —
# use a resend.dev sandbox address (e.g. delivered@resend.dev) as EMAIL_FROM's
# recipient in dev.
RESEND_API_KEY="re_your-api-key"
EMAIL_FROM="onboarding@resend.dev"

# Anthropic (console.anthropic.com/settings/keys) — powers AI-assisted course
# generation (admin/courses/generate). Server-only.
ANTHROPIC_API_KEY="sk-ant-your-api-key"

# Your deployed site's own URL — used to build links in emails sent with no
# browser request context (services/subscriptions/send-expiry-reminders.ts,
# run by a Vercel Cron job, has no headers()/origin to read from).
SITE_URL="https://your-domain.com"

# Authenticates Vercel Cron's daily call to /api/cron/subscription-reminders
# (vercel.json). Vercel sends this exact value as `Authorization: Bearer
# <CRON_SECRET>` automatically once this env var is set on the project —
# generate a random string, e.g. `openssl rand -hex 32`.
CRON_SECRET="a-long-random-string"
