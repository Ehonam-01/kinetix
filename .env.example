# Postgres connection used by Drizzle (server-only). Get this from your Supabase
# project's Database settings (use the pooled "Transaction" connection string).
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase project settings (Project Settings > API). Public: inlined into the
# client bundle at build time, safe to expose — Drizzle (above) is what talks
# to Postgres server-side, so no service role key is needed here.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Moneroo (Dashboard > Developers). Use a test_ key for sandbox. Server-only.
MONEROO_SECRET_KEY="test_your-secret-key"
# Dashboard > Developers > Webhooks > (your endpoint) > signing secret.
MONEROO_WEBHOOK_SECRET="your-webhook-signing-secret"

# Resend (resend.com/api-keys) — sends the transfer confirmation OTP email
# (services/wallet/initiate-transfer.ts). Server-only. Resend requires a
# verified sending domain (Dashboard > Domains) for EMAIL_FROM in
# production; onboarding@resend.dev is the address Resend's own docs use
# as a test sender before you've verified one. Testing without a verified
# domain also means real recipients besides yourself may not receive mail —
# use a resend.dev sandbox address (e.g. delivered@resend.dev) as EMAIL_FROM's
# recipient in dev.
RESEND_API_KEY="re_your-api-key"
EMAIL_FROM="onboarding@resend.dev"

# Anthropic (console.anthropic.com/settings/keys) — powers AI-assisted course
# generation (admin/courses/generate). Server-only.
ANTHROPIC_API_KEY="sk-ant-your-api-key"
